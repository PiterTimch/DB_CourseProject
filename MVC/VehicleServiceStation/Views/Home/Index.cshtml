@{
    ViewData["Title"] = "Огляд";
}
<section class="welcome-panel">
    <div class="welcome-copy"><span class="welcome-badge"><span></span> СЕРВІСНА ПЛАТФОРМА</span><p class="welcome-date">@DateTime.Today.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("uk-UA"))</p><h1>Добрий день,<br /><em>@(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity?.Name).</em></h1><p class="welcome-description">Усі важливі процеси сервісного центру — в одному робочому просторі.</p>
    @if (User.IsInRole(AccessRoles.Manager) || User.IsInRole(AccessRoles.Admin))
    {
        <a class="button button-primary welcome-cta" asp-controller="Orders" asp-action="Create">Створити замовлення <span>→</span></a>
    }
    else if (User.IsInRole(AccessRoles.Guest))
    {
        <a class="button button-primary welcome-cta" asp-controller="History" asp-action="Index">Знайти історію авто <span>→</span></a>
    }
    else if (User.IsInRole(AccessRoles.Director))
    {
        <div class="form-note welcome-cta">Звіти для керівника доступні у Java-застосунку.</div>
    }
    </div>
    <div class="welcome-art"><div class="art-ring ring-a"></div><div class="art-ring ring-b"></div><div class="art-center"><span>GF</span><small>CARE IN<br />EVERY DETAIL</small></div><span class="art-spark spark-a">✳</span><span class="art-spark spark-b">·</span><div class="art-label">SERVICE<br />CONTROL</div></div>
</section>
<div class="section-heading"><div><p class="eyebrow">ШВИДКИЙ ДОСТУП</p><h2>З чого почнемо?</h2></div><span class="muted">Оберіть потрібний розділ</span></div>
<section class="action-grid">
    @if (User.IsInRole(AccessRoles.Manager) || User.IsInRole(AccessRoles.Admin))
    {
        <a class="action-card action-card-featured" asp-controller="Orders" asp-action="Index"><span class="action-icon icon-amber">▤</span><span class="action-arrow">↗</span><strong>Замовлення</strong><small>Створення та супровід робіт</small></a>
        <a class="action-card" asp-controller="Customers" asp-action="Index"><span class="action-icon icon-green">◎</span><span class="action-arrow">↗</span><strong>Клієнти</strong><small>Контакти й дані власників</small></a>
        <a class="action-card" asp-controller="Cars" asp-action="Index"><span class="action-icon icon-blue">◈</span><span class="action-arrow">↗</span><strong>Автомобілі</strong><small>Транспорт і власники</small></a>
        <a class="action-card" asp-controller="History" asp-action="Index"><span class="action-icon icon-violet">↗</span><span class="action-arrow">↗</span><strong>Історія сервісу</strong><small>Знайти за системним ID авто</small></a>
    }
    @if (User.IsInRole(AccessRoles.Guest))
    {
        <a class="action-card action-card-featured" asp-controller="History" asp-action="Index"><span class="action-icon icon-violet">↗</span><span class="action-arrow">↗</span><strong>Історія сервісу</strong><small>Знайти за системним ID авто</small></a>
    }
    @if (User.IsInRole(AccessRoles.Admin))
    {
        <a class="action-card" asp-controller="Services" asp-action="Index"><span class="action-icon icon-green">✳</span><span class="action-arrow">↗</span><strong>Послуги</strong><small>Каталог робіт і ціни</small></a>
        <a class="action-card" asp-controller="Parts" asp-action="Index"><span class="action-icon icon-blue">⬡</span><span class="action-arrow">↗</span><strong>Запчастини</strong><small>Довідник комплектуючих</small></a>
        <a class="action-card" asp-controller="Employees" asp-action="Index"><span class="action-icon icon-amber">♙</span><span class="action-arrow">↗</span><strong>Працівники</strong><small>Облікові записи та ролі</small></a>
    }
    @if (User.IsInRole(AccessRoles.Director))
    {
        <div class="action-card action-card-static"><span class="action-icon icon-amber">▥</span><strong>Звіти</strong><small>Перегляд у Java-застосунку</small></div>
    }
</section>
