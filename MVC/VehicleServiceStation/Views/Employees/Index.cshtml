@model IReadOnlyList<Employee>
@{
    ViewData["Title"] = "Працівники";
}
<div class="page-heading"><div><p class="eyebrow">КЕРУВАННЯ ДОСТУПОМ</p><h1>Працівники</h1><p class="heading-note">Облікові записи та ролі команди</p></div><a class="button button-primary" asp-action="Create"><span>＋</span> Додати працівника</a></div>
<section class="page-card">
    <div class="card-toolbar"><div><strong>Команда сервісу</strong><span class="count-pill">@Model.Count</span></div><span class="muted">Паролі зберігаються у вигляді хешу</span></div>
    @if (Model.Count == 0)
    {
        <div class="table-empty"><span>♙</span><strong>Працівників ще немає</strong><p>Створіть перший обліковий запис команди.</p></div>
    }
    else
    {
        <div class="table-responsive"><table class="data-table"><thead><tr><th>ПРАЦІВНИК</th><th>ЛОГІН</th><th>РОЛЬ</th><th></th></tr></thead><tbody>
        @foreach (var employee in Model)
        {
            <tr><td><strong>@employee.LastName @employee.FirstName</strong><small class="cell-sub">ID @employee.EmployeeId.ToString("D4")</small></td><td class="mono-text">@employee.Login</td><td><span class="role-badge role-@employee.Role">@employee.Role</span></td><td class="row-actions"><a class="text-link" asp-action="Edit" asp-route-id="@employee.EmployeeId">Редагувати</a><form asp-action="Delete" asp-route-id="@employee.EmployeeId" method="post"><button class="text-link text-danger" type="submit">Видалити</button></form></td></tr>
        }
        </tbody></table></div>
    }
</section>
