@model CustomerForm
@{
    ViewData["Title"] = "Редагувати клієнта";
}
<div class="page-heading"><div><p class="eyebrow">КЛІЄНТСЬКА БАЗА · ID @Model.CustomerId</p><h1>Редагувати клієнта</h1><p class="heading-note">Оновіть контактні дані</p></div></div>
<section class="page-card form-card"><form asp-action="Edit" method="post"><input asp-for="CustomerId" type="hidden" /><partial name="_Form" model="Model" /></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
