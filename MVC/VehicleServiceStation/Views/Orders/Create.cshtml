@model OrderCreateForm
@{
    ViewData["Title"] = "Нове замовлення";
}
<div class="page-heading"><div><p class="eyebrow">ОПЕРАЦІЙНИЙ ПРОЦЕС</p><h1>Нове замовлення</h1><p class="heading-note">Виберіть автомобіль і зафіксуйте вхідний пробіг</p></div></div>
<section class="page-card form-card">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="form-grid">
            <div class="field-block field-full"><label asp-for="CarId">Автомобіль</label><select asp-for="CarId" asp-items="ViewBag.Cars"><option value="">Оберіть авто клієнта</option></select><span asp-validation-for="CarId" class="field-error"></span></div>
            <div class="field-block"><label asp-for="OrderDate">Дата замовлення</label><input asp-for="OrderDate" type="date" /><span asp-validation-for="OrderDate" class="field-error"></span></div>
            <div class="field-block"><label asp-for="Deadline">Бажаний термін</label><input asp-for="Deadline" type="date" /><span asp-validation-for="Deadline" class="field-error"></span></div>
            <div class="field-block"><label asp-for="Mileage">Пробіг, км</label><input asp-for="Mileage" type="number" min="0" step="1" /><span asp-validation-for="Mileage" class="field-error"></span></div>
        </div>
        <div class="form-note"><span>i</span> Відповідальним за замовлення буде ваш обліковий запис. Виконавця робіт можна призначити під час додавання послуги.</div>
        <div class="form-actions"><a class="button button-quiet" asp-action="Index">Скасувати</a><button class="button button-primary" type="submit">Створити замовлення <span>→</span></button></div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
